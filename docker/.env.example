# Copy this file to docker/.env and set secrets before starting services.
GITEA_IMAGE=gitea/gitea:1.24.7-rootless
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.16.0
CADDY_IMAGE=caddy:2.10.2-alpine
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v1.7.0
GITEA_DOMAIN=localhost
GITEA_SSH_DOMAIN=localhost
GITEA_SSH_PORT=2222
GITEA_HTTP_PORT=3000
CADDY_HTTP_PORT=80
MEILISEARCH_MASTER_KEY=replace-with-a-long-random-secret
