# Managed by Ansible. System-wide AmigaLab development environment.
export AMIGALAB_ROOT="{{ amigalab_root }}"
export AMIGALAB_TOOLCHAIN="{{ toolchain_prefix }}"
export AMIGALAB_TOOLCHAIN_PREFIX="$AMIGALAB_TOOLCHAIN"
export AMIGA_TOOLCHAIN_PREFIX="$AMIGALAB_TOOLCHAIN"
export AMIGA_NDK="${AMIGA_NDK:-{{ amigalab_storage_root }}/ndk}"
export VBCC="${VBCC:-$AMIGALAB_TOOLCHAIN_PREFIX/vbcc}"
export PATH="$AMIGALAB_TOOLCHAIN/bin:$PATH"
